# Praxia Agent Core: example configuration.
# Copy to .env and fill in only what you use. Never commit .env.
# The demos run offline with PRAXIA_PROVIDER=mock (the default), no keys needed.

# Which provider the demos use: mock | anthropic | openai | google | auto
PRAXIA_PROVIDER=mock

# Anthropic
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=

# OpenAI (or any compatible endpoint via OPENAI_BASE_URL)
OPENAI_API_KEY=
# OPENAI_MODEL=
# OPENAI_BASE_URL=

# Google Gemini
GOOGLE_API_KEY=
# GOOGLE_MODEL=
